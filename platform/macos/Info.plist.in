<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>AirGestures</string>
  <key>CFBundleIdentifier</key><string>com.nate.airgestures</string>
  <key>CFBundleExecutable</key><string>AirGestures</string>
  <key>NSCameraUsageDescription</key>
  <string>AirGestures reads hand positions from the camera to control your Mac. Video is processed locally and never saved.</string>
  <key>LSUIElement</key><true/>  <!-- menu-bar app, no Dock icon -->
</dict></plist>